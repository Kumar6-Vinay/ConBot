# Required — Gemini API key (Google AI Studio). Text chat and image questions
# check for it up front, even when PRIMARY_MODEL is an OpenRouter model.
GEMINI_API_KEY=your_key_here

# Optional — first model tried, as provider:model_id (default shown).
# Default leads with Gemini direct (free quota, not OpenRouter credit).
# PRIMARY_MODEL=google:gemini-3.1-flash-lite

# Optional — required only for /generate-image (Pollinations.ai)
POLLINATIONS_API_KEY=your_key_here

# Optional — required only if TEXT_FALLBACK_CHAIN includes an openrouter:
# entry (the default chain does). Get one free at openrouter.ai/keys.
OPENROUTER_API_KEY=your_key_here

# Optional — text chat fallback chain, tried in order after PRIMARY_MODEL
# whenever a link 404s (model gone), 429s, 5xx's, times out, or returns an
# empty answer. "provider:model_id" pairs, comma-separated. provider is
# "google" (calls Gemini directly, same key as GEMINI_API_KEY) or
# "openrouter" (calls OpenRouter, needs OPENROUTER_API_KEY above). See
# README.md for how these were chosen and how to pick your own.
# TEXT_FALLBACK_CHAIN=google:gemini-3.5-flash,google:gemini-3.8-flash,openrouter:openai/gpt-5-mini,openrouter:dots-studio/dots-3-note-preview:free,openrouter:nvidia/nemotron-3-ultra-550b-a55b:free

# Optional — fallback chain tuning (defaults shown)
# FALLBACK_ATTEMPT_TIMEOUT=10   # seconds per (provider, model) attempt
# FALLBACK_TOTAL_BUDGET=45      # seconds, whole chain, worst case
# BREAKER_FAILURE_THRESHOLD=3   # consecutive failures before a link goes cold
# BREAKER_COOLDOWN_SECONDS=60   # how long a cold link is skipped entirely
