# Required — Gemini API key (Google AI Studio)
GEMINI_API_KEY=your_key_here

# Optional — required only for /generate-image (Pollinations.ai)
POLLINATIONS_API_KEY=your_key_here

# Optional — required only if TEXT_FALLBACK_CHAIN includes an openrouter:
# entry (the default chain does). Get one free at openrouter.ai/keys.
OPENROUTER_API_KEY=your_key_here

# Optional — text chat fallback chain, tried in order after GEMINI_TEXT_MODEL
# whenever a link 429s, 5xx's, times out, or returns an empty answer.
# "provider:model_id" pairs, comma-separated. provider is "google" (calls
# Gemini directly, same key as GEMINI_API_KEY) or "openrouter" (calls
# OpenRouter, needs OPENROUTER_API_KEY above). See README.md for how these
# were chosen and how to pick your own.
# TEXT_FALLBACK_CHAIN=google:gemini-3.5-flash,google:gemini-3.8-flash,google:gemini-3.1-flash-lite,openrouter:nex-agi/nex-n2.5-mini:free,openrouter:dots-studio/dots-3-note-preview:free,openrouter:nvidia/nemotron-3-super-120b-a12b:free

# Optional — fallback chain tuning (defaults shown)
# FALLBACK_ATTEMPT_TIMEOUT=10   # seconds per (provider, model) attempt
# FALLBACK_TOTAL_BUDGET=45      # seconds, whole chain, worst case
# BREAKER_FAILURE_THRESHOLD=3   # consecutive failures before a link goes cold
# BREAKER_COOLDOWN_SECONDS=60   # how long a cold link is skipped entirely
