# Optional — Gemini API key (Google AI Studio).
# The default PRIMARY_MODEL and fallback chain include Google models, so the
# default configuration needs this key. It is only optional when you override
# PRIMARY_MODEL and TEXT_FALLBACK_CHAIN to use providers you have configured.
GEMINI_API_KEY=your_key_here

# Optional — first model tried, in provider:model_id format.
# Default: Gemini 2.5 Flash direct. Requires GEMINI_API_KEY.
PRIMARY_MODEL=google:gemini-2.5-flash

# Optional — required for any openrouter: entry in PRIMARY_MODEL or
# TEXT_FALLBACK_CHAIN. Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=your_key_here

# Optional — required for any nvidia: entry in PRIMARY_MODEL or
# TEXT_FALLBACK_CHAIN. Get a key from NVIDIA's developer platform.
NVIDIA_API_KEY=your_key_here

# Optional — required for /v1/generate-image.
POLLINATIONS_API_KEY=your_key_here

# Optional — models tried in order after PRIMARY_MODEL when a provider/model
# is unavailable due to a retryable failure. Defaults shown. Prefix each model
# with google:, openrouter:, or nvidia:, and configure the corresponding key.
# TEXT_FALLBACK_CHAIN=google:gemini-2.5-flash-lite,openrouter:nvidia/nemotron-3.5-super-vl:free

# OpenRouter-only example (uncomment and configure the OpenRouter key above):
# PRIMARY_MODEL=openrouter:your-provider/your-model
# TEXT_FALLBACK_CHAIN=

# Optional — fallback chain tuning (defaults shown).
# FALLBACK_ATTEMPT_TIMEOUT=10   # seconds per provider/model attempt
# FALLBACK_TOTAL_BUDGET=45      # seconds for the whole chain
# BREAKER_FAILURE_THRESHOLD=3   # failures before a link goes cold
# BREAKER_COOLDOWN_SECONDS=60   # seconds a cold link is skipped
