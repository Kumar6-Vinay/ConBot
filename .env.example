# Optional — Gemini API key (Google AI Studio). Needed if any google: model
# is in PRIMARY_MODEL or TEXT_FALLBACK_CHAIN. Can be omitted if you only use
# nvidia: models and set NVIDIA_API_KEY instead.
GEMINI_API_KEY=your_key_here

# Optional — first model tried, as provider:model_id (default shown).
# Default leads with Nemotron 3.5 Super VL 120B A12B via NVIDIA NIM
# (build.nvidia.com), using NVIDIA_API_KEY directly — no OpenRouter middleman.
# Verify the exact model slug on NVIDIA's catalog. Free models get
# retired/repriced without notice — if you see 404s, update this to a
# current model id.
# To use Gemini direct instead:
#   PRIMARY_MODEL=google:gemini-2.5-flash
PRIMARY_MODEL=nvidia:nvidia/nemotron-3.5-super-120b-vl-a12b

# Optional — NVIDIA API key (build.nvidia.com). Required if PRIMARY_MODEL or
# TEXT_FALLBACK_CHAIN includes an nvidia: model. Get one free at
# build.nvidia.com.
NVIDIA_API_KEY=your_key_here

# Optional — required only for /generate-image (Pollinations.ai)
POLLINATIONS_API_KEY=your_key_here

# Optional — required only if TEXT_FALLBACK_CHAIN includes an openrouter:
# entry. Get one free at openrouter.ai/keys.
OPENROUTER_API_KEY=your_key_here

# Optional — text chat fallback chain, tried in order after PRIMARY_MODEL
# whenever a link 404s (model gone), 429s, 5xx's, times out, or returns an
# empty answer. "provider:model_id" pairs, comma-separated. provider is
# "google" (calls Gemini directly, same key as GEMINI_API_KEY),
# "nvidia" (calls NVIDIA NIM directly, needs NVIDIA_API_KEY above), or
# "openrouter" (calls OpenRouter, needs OPENROUTER_API_KEY above).
# TEXT_FALLBACK_CHAIN=google:gemini-2.0-flash,google:gemini-1.5-flash,openrouter:google/gemini-2.0-flash:free

# Optional — fallback chain tuning (defaults shown)
# FALLBACK_ATTEMPT_TIMEOUT=10   # seconds per (provider, model) attempt
# FALLBACK_TOTAL_BUDGET=45      # seconds, whole chain, worst case
# BREAKER_FAILURE_THRESHOLD=3   # consecutive failures before a link goes cold
# BREAKER_COOLDOWN_SECONDS=60   # how long a cold link is skipped entirely
